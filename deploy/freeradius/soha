rest soha_verify_password {
	tls {
		ca_info_file = $ENV{SOHA_RADIUS_CONTROL_CA_FILE}
		certificate_file = $ENV{SOHA_RADIUS_CONTROL_CERT_FILE}
		private_key_file = $ENV{SOHA_RADIUS_CONTROL_KEY_FILE}
		check_cert = yes
		check_cert_cn = yes
	}
	connect_timeout = 3.0
	authenticate {
		uri = "$ENV{SOHA_RADIUS_CONTROL_URL}/api/network-control/v1/runtimes/$ENV{SOHA_RADIUS_RUNTIME_ID}/radius:verify-password"
		method = post
		body = json
		data = '{"requestId":"verify-%{sha256:%{outer.request:NAS-Identifier}|%{User-Name}|%{control:Tmp-String-0}|%{outer.request:State}}","nasId":"%{outer.request:NAS-Identifier}","stationId":"%{control:Tmp-String-0}","login":"%{User-Name}","passwordBase64":"%{base64:&User-Password}","eapMethod":"ttls","innerMethod":"pap"%{outer.control:Tmp-String-9}}'
		force_to = json
		tls = ${..tls}
		timeout = 3.0
		chunk = 4096
	}
}

