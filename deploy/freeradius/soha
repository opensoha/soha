rest soha_managed_admit {
	connect_uri = "http://localhost"
	connect_uri_socket = "$ENV{SOHA_RADIUS_HOOK_SOCKET}"
	connect_timeout = 1.0
	pool {
		start = $ENV{SOHA_RADIUS_HOOK_POOL_START}
		min = $ENV{SOHA_RADIUS_HOOK_POOL_START}
		max = ${thread[pool].max_servers}
		spare = 1
		uses = 0
		lifetime = 0
		idle_timeout = 5
	}
	authorize {
		uri = "http://localhost/admit"
		method = post
		body = json
		data = '{"epoch":"%{control:Tmp-String-6}","nasId":"%{NAS-Identifier}","stationId":"%{Calling-Station-Id}","state":"%{State}"}'
		force_to = json
		timeout = 1.0
		chunk = 4096
	}
}

