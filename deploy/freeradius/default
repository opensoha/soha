server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}
	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		if (!&User-Name || &User-Name !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/ || !&NAS-Identifier || &NAS-Identifier != "$ENV{SOHA_RADIUS_NAS_ID}" || !&Calling-Station-Id || &Calling-Station-Id !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/) {
			soha_reject_tracked
		}
		if ("$ENV{SOHA_RADIUS_MANAGED_ENABLED}" == "true") {
			update control {
				&Tmp-String-6 := "$ENV{SOHA_RADIUS_PROCESS_EPOCH}"
				&Tmp-String-8 := ""
				&Tmp-String-9 := ""
			}
			if (!&EAP-Message) {
				soha_reject_tracked
			}
			soha_managed_admit
			if (fail || invalid || reject || userlock || notfound || !&control:Tmp-String-8 || &control:Tmp-String-8 !~ /^[A-Za-z0-9_-]{43}$/ || !&control:Tmp-String-9) {
				soha_reject_tracked
			}
		}
		if (&EAP-Message) {
			eap {
				ok = return
				updated = return
			}
		}
		else {
			soha_lab_users
			if (notfound) {
				soha_reject_tracked
			}
			pap
		}
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		eap
	}

	preacct {
		preprocess
		acct_unique
	}

	accounting {
		if (!&Event-Timestamp || !&NAS-Identifier || &NAS-Identifier != "$ENV{SOHA_RADIUS_NAS_ID}") {
			fail
		}
		update control {
			&Tmp-String-2 := ""
			&Tmp-String-3 := ""
		}
		if (&Acct-Status-Type == Accounting-On || &Acct-Status-Type == Accounting-Off) {
			update request {
				&Acct-Session-Id := "nas-epoch"
				&NAS-Port-Id := "nas-reset"
				&User-Name := "nas-runtime"
				&Calling-Station-Id := "nas-runtime"
			}
			update control {
				&Tmp-String-1 := "nas-epoch"
			}
			if (&Acct-Status-Type == Accounting-On) {
				update control {
					&Tmp-String-0 := "accounting-on"
				}
			}
			else {
				update control {
					&Tmp-String-0 := "accounting-off"
				}
			}
		}
		else {
			update control {
				&Tmp-String-1 := "%{string:&Class}"
			}
			if (!&Acct-Session-Id || &Acct-Session-Id !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/ || !&NAS-Port-Id || &NAS-Port-Id !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/ || !&User-Name || &User-Name !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/ || !&Calling-Station-Id || &Calling-Station-Id !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/ || !&control:Tmp-String-1 || &control:Tmp-String-1 !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/) {
				fail
			}
			if (&Acct-Status-Type == Start) {
				update control {
					&Tmp-String-0 := "start"
				}
			}
			elsif (&Acct-Status-Type == Interim-Update) {
				update control {
					&Tmp-String-0 := "interim-update"
				}
			}
			elsif (&Acct-Status-Type == Stop) {
				update control {
					&Tmp-String-0 := "stop"
				}
			}
			else {
				fail
			}
			if (&Tunnel-Private-Group-Id && &Tunnel-Private-Group-Id =~ /^[0-9]{1,4}$/) {
				update control {
					&Tmp-Integer-0 := "%{Tunnel-Private-Group-Id}"
				}
				if (&control:Tmp-Integer-0 > 0 && &control:Tmp-Integer-0 < 4095) {
					update control {
						&Tmp-String-2 := ",\"observedVlanId\":%{control:Tmp-Integer-0}"
					}
				}
			}
			if (&Filter-Id && &Filter-Id =~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/) {
				update control {
					&Tmp-String-3 := ",\"observedFilterId\":\"%{Filter-Id}\""
				}
			}
		}
		soha_accounting_control
		if (fail || invalid || reject || userlock || notfound) {
			fail
		}
		soha_accounting
		if (fail || invalid) {
			fail
		}
		if ("$ENV{SOHA_RADIUS_ADMISSION_EVENTS_ENABLED}" == "true" && &Acct-Status-Type != Accounting-On && &Acct-Status-Type != Accounting-Off) {
			if (!&NAS-Port-Id || &NAS-Port-Id !~ /^(ap0|w1|w2)$/ || &Calling-Station-Id !~ /^([A-Fa-f0-9]{2}[:-]){5}[A-Fa-f0-9]{2}$/) {
				fail
			}
			soha_event_accounting
			if (fail || invalid) {
				fail
			}
		}
	}

	post-auth {
		# The 3.2 virtual attribute expands directly; nested hex expansion is empty.
		if ("%{Packet-Authentication-Vector}" !~ /^0x[A-Fa-f0-9]{32}$/) {
			soha_reject_tracked
		}
		if (!&User-Name || &User-Name !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/ || !&NAS-Identifier || &NAS-Identifier != "$ENV{SOHA_RADIUS_NAS_ID}" || !&Calling-Station-Id || &Calling-Station-Id !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/) {
			soha_reject_tracked
		}
		if (&session-state:Tmp-String-4 || &session-state:Tmp-String-5) {
			if (!&session-state:Tmp-String-4 || &session-state:Tmp-String-4 !~ /^[A-Za-z0-9_-]{43}$/ || !&session-state:Tmp-String-5 || &session-state:Tmp-String-5 !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/) {
				soha_reject_tracked
			}
			if (&Calling-Station-Id =~ /^([0-9a-f]{2})([:-])([0-9a-f]{2})\2([0-9a-f]{2})\2([0-9a-f]{2})\2([0-9a-f]{2})\2([0-9a-f]{2})$/i) {
				update control {
					&Tmp-String-0 := "%{tolower:%{1}:%{3}:%{4}:%{5}:%{6}:%{7}}"
				}
			}
			else {
				soha_reject_tracked
			}
			if (!&control:Tmp-String-0 || &control:Tmp-String-0 !~ /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/) {
				soha_reject_tracked
			}
			soha_authorize_ttls
		}
		elsif (&TLS-Client-Cert-Serial) {
			if (&TLS-Client-Cert-Serial !~ /^[A-Fa-f0-9]{1,40}$/ || !&TLS-Client-Cert-X509v3-Authority-Key-Identifier || &TLS-Client-Cert-X509v3-Authority-Key-Identifier !~ /^[A-Fa-f0-9:]{16,191}$/) {
				soha_reject_tracked
			}
			soha_authorize_eap_tls
		}
		else {
			soha_authorize_password
		}
		if (fail || invalid || notfound || reject || userlock || !&reply:Class) {
			soha_reject_tracked
		}

		if ("$ENV{SOHA_RADIUS_ADMISSION_EVENTS_ENABLED}" == "true") {
			if (!&NAS-Port-Id || &NAS-Port-Id !~ /^(ap0|w1|w2)$/ || &Calling-Station-Id !~ /^([A-Fa-f0-9]{2}[:-]){5}[A-Fa-f0-9]{2}$/ || &reply:Class !~ /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/ || &reply:Filter-Id != "lab-tcp8000-only" || !&reply:Session-Timeout) {
				soha_reject_tracked
			}
			update control {
				&Tmp-String-7 := "null"
			}
			if (&reply:Tunnel-Private-Group-Id) {
				if (&reply:Tunnel-Private-Group-Id !~ /^[0-9]{1,4}$/) {
					soha_reject_tracked
				}
				update control {
					&Tmp-String-7 := "%{integer:reply:Tunnel-Private-Group-Id}"
				}
			}
			soha_event_authorize
			if (fail || invalid) {
				soha_reject_tracked
			}
		}

		if ("$ENV{SOHA_RADIUS_MANAGED_ENABLED}" == "true") {
			if (!&control:Tmp-String-8 || &control:Tmp-String-8 !~ /^[A-Za-z0-9_-]{43}$/ || !&control:Tmp-String-9) {
				soha_reject_tracked
			}
			soha_managed_accept
			if (fail || invalid || reject || userlock || notfound) {
				soha_reject_tracked
			}
			update control {
				&Tmp-String-8 := ""
			}
		}

		Post-Auth-Type Challenge {
			if ("$ENV{SOHA_RADIUS_MANAGED_ENABLED}" == "true") {
				if (!&control:Tmp-String-8 || &control:Tmp-String-8 !~ /^[A-Za-z0-9_-]{43}$/ || !&control:Tmp-String-9) {
					soha_reject_tracked
				}
				soha_managed_challenge
				if (fail || invalid || reject || userlock || notfound || !&reply:State) {
					soha_reject_tracked
				}
				update control {
					&Tmp-String-8 := ""
				}
			}
		}

		Post-Auth-Type REJECT {
			soha_managed_finish_reject
			attr_filter.access_reject
		}
	}
}
