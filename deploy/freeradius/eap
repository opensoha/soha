eap {
	default_eap_type = tls
	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = ${max_requests}

	tls-config tls-common {
		private_key_file = $ENV{SOHA_RADIUS_EAP_KEY_FILE}
		certificate_file = $ENV{SOHA_RADIUS_EAP_CERT_FILE}
		ca_file = $ENV{SOHA_RADIUS_EAP_CA_FILE}
		tls_min_version = "1.2"
		tls_max_version = "1.3"
		cipher_list = "DEFAULT"
		cipher_server_preference = yes
		ecdh_curve = ""
		cache {
			enable = no
		}
	}

	tls {
		tls = tls-common
	}

	ttls {
		tls = tls-common
		copy_request_to_tunnel = no
		use_tunneled_reply = no
		virtual_server = soha-inner-tunnel
		require_client_cert = no
	}
}
