# Host Core example. Use a Core image that supports dsh and apply the required migrations first.
# Uncomment for dsh after all Core workers can read encrypted checkpoints.
# Keep the installation's active credential encryption key in the existing secret configuration.
# SOHA_SECURITY_PROTECTED_DURABLE_STORAGE=true
# New Chat/Heya is unavailable while dsh is disabled. Drain legacy runs before cutover.
SOHA_DSH_RUNTIME_ENABLED=false
SOHA_DSH_RUNTIME_BASE_URL=http://127.0.0.1:8097
SOHA_DSH_RUNTIME_SERVICE_TOKEN_FILE=/run/soha-dsh/service-token
SOHA_DSH_RUNTIME_TIMEOUT=15s
# Set true for the isolated loopback example only, or use an explicitly isolated private link.
# For other deployments use an HTTPS base URL and keep this false.
SOHA_DSH_RUNTIME_ALLOW_INSECURE_HTTP=false
SOHA_HINDSIGHT_ENABLED=false
SOHA_HINDSIGHT_BASE_URL=http://127.0.0.1:8889
SOHA_HINDSIGHT_TOKEN_FILE=/run/soha-hindsight/service-token
SOHA_HINDSIGHT_INSTANCE_NAMESPACE=replace-with-stable-server-owned-instance-id
SOHA_HINDSIGHT_TIMEOUT=15s
