# Copy this file to the ignored EAP test credential directory as
# eapol-test.conf. Replace the identity with the subject ID bound to the
# disposable client certificate. Never place a production private key here.
network={
    key_mgmt=WPA-EAP
    eap=TLS
    identity="replace-with-soha-subject-id"
    ca_cert="/run/soha-radius/eap-test/ca.crt"
    client_cert="/run/soha-radius/eap-test/tls.crt"
    private_key="/run/soha-radius/eap-test/tls.key"
    domain_match="freeradius"
    phase1="tls_disable_tlsv1_0=1 tls_disable_tlsv1_1=1"
}
