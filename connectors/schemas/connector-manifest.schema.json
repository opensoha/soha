{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connectors.opensoha.dev/schemas/connector-manifest.schema.json",
  "title": "OpenSoha Connector Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "status",
    "description",
    "runtime",
    "lifecycle",
    "config",
    "secrets",
    "capabilities",
    "permissions",
    "events",
    "actions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "planned",
        "experimental",
        "stable"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "node",
        "entrypoint"
      ],
      "properties": {
        "language": {
          "const": "typescript"
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^src/.+\\.ts$"
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "created",
          "configured",
          "started",
          "stopped"
        ]
      }
    },
    "config": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configField"
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/secretRef"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "string",
            "boolean",
            "number",
            "secret"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "env",
        "required",
        "purpose"
      ],
      "properties": {
        "env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "required": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "direction",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "inbound",
            "outbound",
            "bidirectional"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "description",
        "required"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "inputSchema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inputSchema": {
          "type": "object"
        },
        "credentialProtocol": {
          "const": "opensoha.dev/connector-action/v1",
          "description": "Opt-in support for per-call delivery, not a requirement for every action call. Without credentials the existing envelope remains valid; actions requiring authentication must reject missing credentials themselves."
        },
        "credentialAliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      },
      "dependentRequired": {
        "credentialProtocol": [
          "credentialAliases"
        ],
        "credentialAliases": [
          "credentialProtocol"
        ]
      },
      "if": {
        "required": [
          "credentialProtocol"
        ]
      },
      "then": {
        "properties": {
          "name": {
            "maxLength": 128
          }
        }
      }
    }
  }
}
