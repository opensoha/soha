# Shared connector HTTP runtime.
SOHA_CONNECTOR_HTTP_HOST=127.0.0.1
SOHA_CONNECTOR_HTTP_PORT=3000
SOHA_CONNECTOR_HTTP_TOKEN=change-me-local-action-token
SOHA_CONNECTOR_HTTP_MAX_BODY_BYTES=1048576
SOHA_CONNECTOR_LOG_LEVEL=info
SOHA_CONNECTOR_EVENT_SINK_URL=
SOHA_CONNECTOR_EVENT_SINK_TOKEN=
SOHA_CONNECTOR_EVENT_SINK_TIMEOUT_MS=5000

# Feishu connector credentials and webhook verification.
SOHA_FEISHU_APP_ID=cli_xxxxxxxxxxxxx
SOHA_FEISHU_APP_SECRET=replace-with-feishu-app-secret
SOHA_FEISHU_VERIFICATION_TOKEN=replace-with-feishu-verification-token
SOHA_FEISHU_ENCRYPT_KEY=
SOHA_FEISHU_BASE_URL=https://open.feishu.cn/open-apis

# Optional local smoke-test auto reply.
SOHA_FEISHU_AUTO_REPLY_ENABLED=false
SOHA_FEISHU_AUTO_REPLY_TEXT=OpenSoha received your Feishu message.

# Reliability defaults. Leave SOHA_FEISHU_RELIABILITY_DIR empty for in-memory
# local testing, or set it to a writable directory for file-backed
# idempotency/dead-letter persistence across runtime restarts.
SOHA_FEISHU_RETRY_MAX=2
SOHA_FEISHU_RETRY_BACKOFF_MS=250
SOHA_FEISHU_IDEMPOTENCY_TTL_MS=86400000
SOHA_FEISHU_ACTION_RATE_LIMIT_PER_MINUTE=120
SOHA_FEISHU_DEAD_LETTER_MAX=100
SOHA_FEISHU_RETRY_QUEUE_MAX=1000
SOHA_FEISHU_RELIABILITY_DIR=
