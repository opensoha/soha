{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opensoha.io/runner/docker-runtime-read.schema.json",
  "title": "Docker identity-bound runtime read request v1",
  "type": "object",
  "required": [
    "protocol",
    "action",
    "projectId",
    "container"
  ],
  "properties": {
    "protocol": {
      "const": "docker-runtime-read-v1"
    },
    "action": {
      "enum": [
        "logs",
        "volumes",
        "files.list",
        "files.read"
      ]
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "container": {
      "$ref": "docker-container-identity.schema.json"
    },
    "tailLines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000
    },
    "sinceSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "target": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "path": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "limitBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "files.list",
              "files.read"
            ]
          }
        }
      },
      "then": {
        "required": [
          "target"
        ]
      }
    }
  ]
}
