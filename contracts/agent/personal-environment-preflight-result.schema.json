{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensoha.dev/schemas/personal-environment-preflight-result.schema.json",
  "title": "Personal Docker Node Preflight Result",
  "description": "Trusted Core only. Uses an owned disposable quota probe and requires its cleanup before a ready receipt. Never provisions personal data or grants task execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "quota",
    "ready",
    "cgroupVersion",
    "diskMechanism",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "opensoha.dev/personal-environment-preflight-result/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "quota": {
      "allOf": [
        {
          "$ref": "https://opensoha.dev/schemas/environment-lease.schema.json#/properties/quota"
        },
        {
          "properties": {
            "diskBytes": {
              "minimum": 16777216,
              "maximum": 1099511627776
            },
            "memoryBytes": {
              "minimum": 33554432,
              "maximum": 17179869184
            },
            "cpuUnits": {
              "minimum": 1,
              "maximum": 8000
            },
            "maxProcesses": {
              "minimum": 4,
              "maximum": 256
            },
            "networkEgress": {
              "const": false
            }
          }
        }
      ]
    },
    "ready": {
      "const": true
    },
    "cgroupVersion": {
      "const": "2"
    },
    "diskMechanism": {
      "const": "btrfs-qgroup"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
