{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "binding",
    "artifactSHA256",
    "diskQuotaBytes",
    "cpuQuotaMilli",
    "memoryBytes",
    "pidsLimit",
    "dockerImage",
    "bubblewrapVersion",
    "dockerVersion",
    "chromiumVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "opensoha.dev/personal-guest-tools/v1"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "binding": {
      "$ref": "personal-guest-binding.schema.json"
    },
    "artifactSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "diskQuotaBytes": {
      "type": "integer",
      "minimum": 16777216,
      "maximum": 1099511627776,
      "multipleOf": 1024
    },
    "cpuQuotaMilli": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8000
    },
    "memoryBytes": {
      "type": "integer",
      "minimum": 33554432,
      "maximum": 17179869184
    },
    "pidsLimit": {
      "type": "integer",
      "minimum": 4,
      "maximum": 256
    },
    "dockerImage": {
      "type": "string",
      "pattern": "^docker\\.io/library/debian@sha256:[a-f0-9]{64}$"
    },
    "bubblewrapVersion": {
      "type": "string",
      "pattern": "^[0-9][a-zA-Z0-9.+:~_-]{0,127}$"
    },
    "dockerVersion": {
      "type": "string",
      "pattern": "^[0-9][a-zA-Z0-9.+:~_-]{0,127}$"
    },
    "chromiumVersion": {
      "type": "string",
      "pattern": "^[0-9][a-zA-Z0-9.+:~_-]{0,127}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensoha.dev/schemas/personal-guest-tools.schema.json",
  "title": "personal-guest-tools",
  "description": "Frozen owner-authorized VM operation. Current mTLS pin, user authorization, resource scope and original reservation must all be valid. SSH launches only a fixed broker; tools installation cannot format, delete or accept model commands. Runtime policy and receipt correlation are additionally validated by the typed protocol."
}
