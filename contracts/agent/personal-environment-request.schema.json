{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://opensoha.dev/schemas/personal-environment-request.schema.json",
  "title": "Personal Environment Agent Request",
  "description": "POST /api/v1/runtime/personal-environments. Trusted Core bearer token and per-action allowlist required. Core derives owner/scope/quota and persists original lease identity. Acquire may recover the same original lease. Execute must never be automatically retried after a lost receipt; its outcome is unknown. Release stops only this lease and retains persistent data. Dispatch/observation has a 30 second deadline and cleanup an independent 30 second deadline; slow cleanup can outlast the HTTP receipt window; sandbox argv uses UTF-8 byte bounds. Export_data uses only POST /runtime/personal-environments/export: bounded framed TAR chunks and a final SHA-256 receipt; no ordinary JSON result, no extraction, no implicit wake.",
  "required": [
    "schemaVersion",
    "action",
    "lease"
  ],
  "properties": {
    "schemaVersion": {
      "const": "opensoha.dev/personal-environment-request/v1"
    },
    "action": {
      "enum": [
        "acquire",
        "inspect",
        "execute",
        "release",
        "delete_data",
        "export_data"
      ]
    },
    "lease": {
      "allOf": [
        {
          "$ref": "https://opensoha.dev/schemas/environment-lease.schema.json"
        },
        {
          "properties": {
            "workspacePath": {
              "const": ""
            },
            "releasedAt": false,
            "quota": {
              "properties": {
                "diskBytes": {
                  "minimum": 16777216,
                  "maximum": 1099511627776
                },
                "memoryBytes": {
                  "minimum": 33554432,
                  "maximum": 17179869184
                },
                "cpuUnits": {
                  "minimum": 1,
                  "maximum": 8000
                },
                "maxProcesses": {
                  "minimum": 4,
                  "maximum": 256
                },
                "networkEgress": {
                  "const": false
                }
              }
            }
          }
        }
      ]
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "maxLength": 4096
        }
      ],
      "items": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000]*$"
      }
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "description": "Execute-only server-owned task UUID. Selects a private temporary task directory inside /workspace; never a host path or persistent-data owner. Omission retains legacy command working directory."
    },
    "createData": {
      "type": "boolean",
      "default": false,
      "description": "Core permits true only during first provisioning, before any ready receipt or task execution. Restore/restart must require existing data; a missing volume or subvolume is an error."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "execute"
          }
        }
      },
      "then": {
        "required": [
          "argv"
        ]
      },
      "else": {
        "properties": {
          "argv": false,
          "taskId": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "inspect",
              "execute",
              "release",
              "delete_data",
              "export_data"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "createData": {
            "const": false
          }
        }
      }
    }
  ]
}
