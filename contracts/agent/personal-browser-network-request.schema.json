{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url",
    "method"
  ],
  "properties": {
    "url": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 4096
    },
    "method": {
      "enum": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ]
    },
    "headers": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "bodyBase64": {
      "type": "string",
      "maxLength": 87384
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensoha.dev/schemas/personal-browser-network-request.schema.json"
}
