{
  "apiVersion": "delivery.soha.io/v1alpha1",
  "kind": "WorkflowTemplate",
  "metadata": {
    "name": "build-release",
    "displayName": "联合构建发布"
  },
  "spec": {
    "definition": {
      "mode": "delivery_batch",
      "schemaVersion": 1,
      "stages": [
        "build",
        "plan",
        "deploy",
        "health"
      ],
      "executionMode": "build_all_then_deploy",
      "stopOnFailure": true,
      "maxConcurrency": 4
    }
  }
}
