{
  "name": "Commerce release",
  "mode": "service_serial",
  "stopOnFailure": false,
  "targets": [
    {
      "id": "web-dev",
      "applicationId": "app-web",
      "serviceId": "web",
      "applicationEnvironmentId": "dev",
      "action": "build_deploy"
    },
    {
      "id": "pay-prod",
      "applicationId": "app-pay",
      "serviceId": "pay",
      "applicationEnvironmentId": "prod",
      "action": "build_deploy",
      "dependsOn": [
        "web-dev"
      ]
    }
  ]
}
