      "additionalProperties": false,
      "properties": {
        "category": {
          "default": "release",
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "^application:"
          },
          "type": "string"
        },
        "definition": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeliveryBatchTemplateDefinition"
            },
            {
              "$ref": "#/$defs/DeliveryDocumentDAG"
            }
          ]
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "migrationPolicy": {
          "$ref": "#/$defs/TemplateMigrationPolicy"
        }
      },
      "required": [
        "definition"
      ],
      "type": "object"
    },
    "DeploymentTemplateGitSource": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "repositoryId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repositoryId",
        "commit",
        "path"
      ],
      "type": "object"
    },
    "DeploymentTemplateHealth": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "workload_ready",
            "job_complete",
            "configuration_only"
          ],
          "type": "string",
          "x-enum-varnames": [
            "DeploymentTemplateHealthWorkloadReady",
            "DeploymentTemplateHealthJobComplete",
            "DeploymentTemplateHealthConfigurationOnly"
          ]
        },
        "timeoutSeconds": {
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "timeoutSeconds"
      ],
      "type": "object"
    },
    "DeploymentTemplateHelmSource": {
      "additionalProperties": false,
      "properties": {
        "chart": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "connectionId": {
          "minLength": 1,
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "repositoryUrl": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "secretRefs": {
          "$ref": "#/$defs/SecretReferenceMap",
          "description": "Application-authorized CHART_USERNAME, CHART_PASSWORD and optional CHART_CA_CERT references. Credentials are resolved only for the selected source."
        },
        "values": {
          "$ref": "#/$defs/TemplateParameterValues"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repositoryUrl",
        "chart",
        "version",
        "values"
      ],
      "type": "object"
    },
    "DeploymentTemplateSource": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "helm"
                ]
              },
              {
                "required": [
                  "kustomize"
                ]
              },
              {
                "required": [
                  "git"
                ]
              }
            ]
          },
          "properties": {
            "renderer": {
              "const": "raw_yaml"
            }
          },
          "required": [
            "files"
          ]
        },
        {
          "not": {
            "required": [
              "helm"
            ]
          },
          "oneOf": [
            {
              "not": {
                "required": [
                  "git"
                ]
              },
              "required": [
                "files"
              ]
            },
            {
              "not": {
                "required": [
                  "files"
                ]
              },
              "required": [
                "git"
              ]
            }
          ],
          "properties": {
            "renderer": {
              "const": "kustomize"
            }
          },
          "required": [
            "kustomize"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "files"
                ]
              },
              {
                "required": [
                  "kustomize"
                ]
              },
              {
                "required": [
                  "git"
                ]
              }
            ]
          },
          "properties": {
            "renderer": {
              "const": "helm"
            }
          },
          "required": [
            "helm"
          ]
        }
      ],
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/ManifestFile"
          },
          "maxItems": 100,
          "type": "array"
        },
        "git": {
          "$ref": "#/$defs/DeploymentTemplateGitSource"
        },
        "helm": {
          "$ref": "#/$defs/DeploymentTemplateHelmSource"
        },
        "kustomize": {
          "$ref": "#/$defs/ManifestKustomizeOptions"
        },
        "renderer": {
          "enum": [
            "raw_yaml",
            "kustomize",
            "helm"
          ],
          "type": "string",
          "x-enum-varnames": [
            "DeploymentTemplateRendererRawYAML",
            "DeploymentTemplateRendererKustomize",
            "DeploymentTemplateRendererHelm"
          ]
        }
      },
      "required": [
        "renderer"
      ],
      "type": "object"
    },
    "ManifestFile": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 524288,
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "type": "object"
    },
    "ManifestKustomizeImage": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "name": {
          "description": "Image name matched by the native Kustomize images transformer.",
          "minLength": 1,
          "type": "string"
        },
        "newName": {
          "description": "Optional replacement image repository, without a tag or digest.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "digest"
      ],
      "type": "object"
    },
    "ManifestKustomizeOptions": {
      "additionalProperties": false,
      "properties": {
        "entryPath": {
          "description": "Directory containing a standard Kustomization file, relative to the package root. Defaults to the package root; the root retains shared bases and generator files.",
          "maxLength": 1024,
          "pattern": "^(\\.|\\.?[A-Za-z0-9_-][A-Za-z0-9_.-]*(/\\.?[A-Za-z0-9_-][A-Za-z0-9_.-]*)*)?$",
          "type": "string"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/ManifestKustomizeImage"
          },
          "maxItems": 50,
          "type": "array"
        }
      },
      "type": "object"
    },
    "SecretReferenceMap": {
      "additionalProperties": {
        "pattern": "^soha://secrets/[A-Za-z0-9._-]+(?:/versions/[1-9][0-9]*)?$",
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      },
      "type": "object"
    },
    "TemplateMigrationPolicy": {
      "additionalProperties": false,
      "if": {
        "anyOf": [
          {
            "properties": {
              "sequential": {
                "const": true
              }
            },
            "required": [
              "sequential"
            ]
          },
          {
            "properties": {
              "irreversible": {
                "const": true
              }
            },
            "required": [
              "irreversible"
            ]
          }
        ]
      },
      "properties": {
        "guide": {
          "description": "Human migration/recovery instructions. Never executed as a script.",
          "maxLength": 2000,
          "type": "string"
        },
        "irreversible": {
          "description": "Forward changes require approval; ordinary rollback across this boundary is forbidden.",
          "type": "boolean"
        },
        "sequential": {
          "description": "Must cross this boundary as adjacent published versions; approval cannot waive it.",
          "type": "boolean"
        }
      },
      "required": [
        "sequential",
        "irreversible"
      ],
      "then": {
        "properties": {
          "guide": {
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "guide"
        ]
      },
      "type": "object"
    },
    "TemplateParameterSchema": {
      "additionalProperties": false,
      "description": "Restricted JSON Schema. Objects reject undeclared keys unless mapValues specifies their schema. secret_reference accepts only a namespaced Secret name/key reference, never a plaintext credential. External references and executable expressions are unsupported.",
      "properties": {
        "description": {
          "maxLength": 1024,
          "type": "string"
        },
        "enum": {
          "items": {
            "oneOf": [
              {
                "maxLength": 16384,
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "items": {
          "$ref": "#/$defs/TemplateParameterSchema"
        },
        "mapValues": {
          "$ref": "#/$defs/TemplateParameterSchema"
        },
        "maximum": {
          "type": "number"
        },
        "maxItems": {
          "maximum": 256,
          "minimum": 0,
          "type": "integer"
        },
        "maxLength": {
          "maximum": 16384,
          "minimum": 0,
          "type": "integer"
        },
        "minimum": {
          "type": "number"
        },
        "minItems": {
          "maximum": 256,
          "minimum": 0,
          "type": "integer"
        },
        "minLength": {
          "maximum": 16384,
          "minimum": 0,
          "type": "integer"
        },
        "properties": {
          "additionalProperties": {
            "$ref": "#/$defs/TemplateParameterSchema"
          },
          "maxProperties": 64,
          "type": "object"
        },
        "required": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "type": {
          "$ref": "#/$defs/TemplateParameterType"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "TemplateParameterType": {
      "enum": [
        "string",
        "boolean",
        "number",
        "integer",
        "object",
        "array",
        "secret_reference"
      ],
      "type": "string",
      "x-enum-varnames": [
        "TemplateParameterString",
        "TemplateParameterBoolean",
        "TemplateParameterNumber",
        "TemplateParameterInteger",
        "TemplateParameterObject",
        "TemplateParameterArray",
        "TemplateParameterSecretReference"
      ]
    },
    "TemplateParameterValue": {
      "description": "JSON parameter value. The template schema further constrains each value; depth is limited to 12 and combined inputs to 64 KiB at runtime.",
      "oneOf": [
        {
          "maxLength": 16384,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/TemplateParameterValue"
          },
          "maxItems": 256,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/TemplateParameterValue"
          },
          "maxProperties": 64,
          "type": "object"
        }
      ]
    },
    "TemplateParameterValues": {
      "additionalProperties": {
        "$ref": "#/$defs/TemplateParameterValue"
      },
      "maxProperties": 64,
      "type": "object"
    }
  },
  "$id": "https://contracts.opensoha.dev/delivery/document.schema.json",
  "$ref": "#/$defs/DeliveryDocument",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Soha Delivery Document"
}
