{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opensoha.dev/skills/skill-manifest.schema.json",
  "title": "Soha Skill Manifest",
  "description": "Structured front matter extracted from official Soha skill markdown files.",
  "type": "object",
  "required": ["id", "name", "category"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "category": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "packageDigest": {
      "type": "string",
      "description": "SHA-256 digest of the package contents. It identifies content only; trial-run eligibility is proven solely by Core.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilityRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "permissionKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requiredScopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "providerSkillRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["providerKind", "ref"],
        "properties": {
          "providerKind": { "type": "string" },
          "ref": { "type": "string" },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "object",
      "description": "Invocation parameters indexed by parameter name.",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["string", "integer", "number", "boolean"] },
          "description": { "type": "string", "maxLength": 256 },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

