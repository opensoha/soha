{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opensoha.dev/plugins/plugin-release-attestation.schema.json",
  "title": "Plugin release attestation v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "pluginId",
    "version",
    "repository",
    "commitSha",
    "rawManifestSha256",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*\\.[a-z0-9][a-z0-9._-]*$",
      "maxLength": 255
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[a-z0-9-]+/[a-z0-9_.-]+$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "rawManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "components": {
      "oneOf": [
        {
          "$ref": "https://contracts.opensoha.dev/plugins/plugin-manifest.schema.json#/$defs/packageComponents"
        },
        {
          "type": "object",
          "maxProperties": 0
        }
      ]
    }
  },
  "additionalProperties": false
}
