  "version": "0.1.0",
  "source": {
    "repository": "github.com/opensoha/soha",
    "path": "internal/domain/cluster/capabilities.go",
    "syncStrategy": "Update this catalog from the Soha cluster DefaultCapabilityMatrix before publishing a soha-skills release. Local validation checks platformCapabilityRefs against this snapshot and, when a sibling soha checkout exists, checks the snapshot for source drift."
