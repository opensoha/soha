{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensoha.dev/schemas/skills-release-manifest.schema.json",
  "title": "OpenSoha Skills Release Manifest",
  "type": "object",
  "required": ["schemaVersion", "version", "format", "artifact", "manifestUrl", "files"],
  "properties": {
    "schemaVersion": {
      "const": "opensoha.dev/skills-release/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][A-Za-z0-9.-]+)?$"
    },
    "format": {
      "const": "tar.gz"
    },
    "artifact": {
      "type": "string",
      "pattern": "^soha-skills-[0-9]+\\.[0-9]+\\.[0-9]+([-+][A-Za-z0-9.-]+)?\\.tar\\.gz$"
    },
    "manifestUrl": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
