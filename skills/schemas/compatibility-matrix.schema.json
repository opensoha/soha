{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensoha.dev/schemas/compatibility-matrix.schema.json",
  "title": "OpenSoha Skills Compatibility Matrix",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "skillsVersion",
    "gatewayCapabilityCatalogVersion",
    "platformCapabilityCatalogVersion",
    "requiredScopes",
    "supportedVersions",
    "contractSchemas",
    "installStrategy"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "opensoha.dev/skills-compatibility-matrix/v1"
    },
    "skillsVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][A-Za-z0-9.-]+)?$"
    },
    "gatewayCapabilityCatalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][A-Za-z0-9.-]+)?$"
    },
    "platformCapabilityCatalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][A-Za-z0-9.-]+)?$"
    },
    "requiredScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supportedVersions": {
      "type": "object",
      "required": ["soha-core", "soha-cli", "soha-agent"],
      "properties": {
        "soha-core": {
          "type": "string",
          "minLength": 1
        },
        "soha-cli": {
          "type": "string",
          "minLength": 1
        },
        "soha-agent": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "contractSchemas": {
      "type": "object",
      "required": ["preferred", "fallback", "policy", "assets"],
      "properties": {
        "preferred": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "assets": {
          "type": "object",
          "required": ["skillManifest", "mcpPreset", "agentProfile"],
          "properties": {
            "skillManifest": {
              "$ref": "#/$defs/ContractSchemaLocation"
            },
            "mcpPreset": {
              "$ref": "#/$defs/ContractSchemaLocation"
            },
            "agentProfile": {
              "$ref": "#/$defs/ContractSchemaLocation"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "installStrategy": {
      "type": "object",
      "required": ["wrapperPackage", "rawSkillsRuntime"],
      "properties": {
        "wrapperPackage": {
          "type": "object",
          "required": ["install", "upgrade", "rollback"],
          "properties": {
            "install": {
              "type": "string",
              "minLength": 1
            },
            "upgrade": {
              "type": "string",
              "minLength": 1
            },
            "rollback": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "rawSkillsRuntime": {
          "type": "object",
          "required": ["path", "install", "upgrade", "rollback"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "install": {
              "type": "string",
              "minLength": 1
            },
            "upgrade": {
              "type": "string",
              "minLength": 1
            },
            "rollback": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "ContractSchemaLocation": {
      "type": "object",
      "required": ["preferred", "fallback"],
      "properties": {
        "preferred": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
