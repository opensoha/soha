{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensoha.dev/schemas/platform-capability-catalog.schema.json",
  "title": "OpenSoha Platform Capability Catalog Snapshot",
  "type": "object",
  "required": ["$schema", "schemaVersion", "version", "source", "capabilities"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "opensoha.dev/platform-capability-catalog/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][A-Za-z0-9.-]+)?$"
    },
    "source": {
      "type": "object",
      "required": ["repository", "path", "syncStrategy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "syncStrategy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "category",
          "requiredScopes",
          "riskLevel",
          "requiresApproval",
          "docsUrl",
          "direct",
          "agent"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "requiredScopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "riskLevel": {
            "type": "string",
            "enum": ["read", "analyze", "mutate", "execute", "high"]
          },
          "requiresApproval": {
            "type": "boolean"
          },
          "docsUrl": {
            "type": "string",
            "minLength": 1
          },
          "direct": {
            "$ref": "#/$defs/modeSupport"
          },
          "agent": {
            "$ref": "#/$defs/modeSupport"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "modeSupport": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["available", "partial", "unsupported"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
