{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensoha.dev/schemas/ai-platform-capability-catalog.schema.json",
  "title": "OpenSoha AI Platform HTTP Capability Catalog",
  "type": "object",
  "required": ["$schema", "schemaVersion", "version", "source", "capabilities"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "opensoha.dev/ai-platform-capability-catalog/v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][A-Za-z0-9.-]+)?$" },
    "source": {
      "type": "object",
      "required": ["repository", "path", "syncStrategy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "syncStrategy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "title", "method", "path", "riskLevel", "permissionKeys", "requiredScopes", "requiresApproval", "status"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "method": { "enum": ["GET", "POST", "DELETE"] },
          "path": { "type": "string", "pattern": "^/api/v1/ai/.*$" },
          "riskLevel": { "enum": ["read", "analyze", "mutate", "execute", "high"] },
          "permissionKeys": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "requiredScopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "requiresApproval": { "type": "boolean" },
          "status": { "enum": ["stable-runtime", "baseline-approved", "baseline-proposed", "deprecated"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
