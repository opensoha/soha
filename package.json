{
  "name": "soha-web",
  "private": true,
  "version": "0.1.11",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs --baseline scripts/baselines/bundle-baseline.json --mode p0 --scope initial",
    "check:frontend-boundaries": "node scripts/check-frontend-boundaries.mjs --enforce",
    "check:release-workflow": "node scripts/check-release-workflow.mjs",
    "check:routes": "node scripts/analyze-route-baseline.mjs --check && node scripts/check-route-registry.mjs",
    "browser:baseline": "playwright test e2e/ui-mock/baseline.spec.ts",
    "release:verify-dist": "node scripts/verify-release-artifact.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs --check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:stable": "playwright test --repeat-each=3 --retries=0",
    "test:guards": "vitest run scripts/quality-guards.test.mjs scripts/model-proxy.test.mjs",
    "test:e2e:ai": "node scripts/run-ai.mjs",
    "test:api:real": "playwright test --config playwright.real.config.ts e2e/api",
    "test:flow:real": "playwright test --config playwright.real.config.ts e2e/flows",
    "check:auth-artifacts": "node scripts/check-auth-artifacts.mjs",
    "check:quality-workflows": "node scripts/check-quality-workflows.mjs"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.5",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/x": "^2.1.3",
    "@ant-design/x-markdown": "2.9.0",
    "@antv/g6": "^5.0.49",
    "@monaco-editor/react": "^4.7.0",
    "@novnc/novnc": "^1.7.0",
    "@opensoha/contracts": "git+https://github.com/opensoha/soha-contracts.git#d1eaebb02c5bb222badf52dc43d569ccedc34c02",
    "@tailwindcss/vite": "^4.1.5",
    "@tanstack/react-query": "^5.75.7",
    "@visactor/react-vchart": "^2.0.22",
    "@visactor/vchart": "^2.0.22",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "antd": "6.6.2",
    "axios": "^1.9.0",
    "dagre": "^0.8.5",
    "dayjs": "^1.11.13",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "react-window": "^2.2.7",
    "yaml": "^2.8.3",
    "zod": "^3.24.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@midscene/web": "1.14.0",
    "@playwright/test": "1.63.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "22.19.15",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "geojson-flatten": {
      "minimist": "1.2.8"
    },
    "monaco-editor": {
      "dompurify": "3.4.13"
    },
    "@midscene/core": {
      "js-yaml": "4.3.2"
    },
    "@midscene/shared": {
      "sharp": "0.35.4",
      "uuid": "11.1.1"
    },
    "@midscene/playground": {
      "uuid": "11.1.1"
    }
  }
}
